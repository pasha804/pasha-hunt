                detected_title = l.strip().title()
                break
    if not detected_title:
        detected_title = "Professional Specialist"

    # 7. SUMMARY EXTRACTION
    summary = ""
    sum_m = re.search(r"(?:ABOUT ME|PROFESSIONAL SUMMARY|SUMMARY|PROFILE|OBJECTIVE)\s*[:\n](.*?)(?=(?:EXPERIENCE|WORK|SKILLS|EDUCATION|PROJECTS|CONTACT|$))", text, re.DOTALL | re.IGNORECASE)
    if sum_m:
        cleaned_sum = re.sub(r"\s+", " ", sum_m.group(1)).strip()
        if len(cleaned_sum) > 20:

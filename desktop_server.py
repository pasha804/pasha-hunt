            "social media manager", "brand manager", "campaign manager"
        ]),
        ("hr", "Talent Acquisition & HR Specialist", [
            "talent acquisition", "technical recruiter", "human resources", "hr manager", "people operations", "hr generalist"
        ])
    ]

    detected_disc = "other"
    detected_title = ""

    for disc, def_title, kw_list in role_rules:
        hits = sum(1 for kw in kw_list if kw in text_lower)
        if hits >= 1:
            detected_disc = disc
            for kw in kw_list:
                if kw in text_lower and len(kw) > 6:
                    detected_title = kw.title()
                    break
            if not detected_title:
                detected_title = def_title
            break

    if not detected_title:
        for l in lines[1:5]:

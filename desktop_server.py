    while True:
        if AUTOPILOT_STATE["enabled"]:
            AUTOPILOT_STATE["status"] = "Active (Sweeping Radars & IMAP)"
            AUTOPILOT_STATE["last_run"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

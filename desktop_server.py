def resolve_file(filename, for_write=False):
    """Resolves path for reading or writing runtime state."""
    user_data_dir = get_user_data_dir()
    user_target = os.path.join(user_data_dir, filename)

    if for_write:
        os.makedirs(os.path.dirname(user_target), exist_ok=True)
        return user_target

    if os.path.exists(user_target):
        return user_target

    candidates = []
    if getattr(sys, 'frozen', False):
        exe_dir = os.path.dirname(sys.executable)
        candidates.append(os.path.join(exe_dir, filename))
        if hasattr(sys, '_MEIPASS'):
            candidates.append(os.path.join(sys._MEIPASS, filename))
    here = os.path.dirname(os.path.abspath(__file__))
    candidates.append(os.path.join(here, filename))
    candidates.append(os.path.join("E:\\Job Hunt", filename))
    candidates.append(os.path.join("E:\\Job Hunt\\job-hunter-repo", filename))
    local_app_data = os.environ.get("LOCALAPPDATA", "")
    if local_app_data:
        candidates.append(os.path.join(local_app_data, "Programs", "Pasha Hunt", filename))
    for c in candidates:
        if os.path.exists(c):
            return c
    return user_target


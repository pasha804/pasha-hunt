def parse_cv_with_gemini(text):
    """Deep document intelligence via Google Gemini 3.5/3.1 Flash Lite with multi-key failover
    and seamless deterministic local fallback."""
    if not text or len(text.strip()) < 30:
        return parse_cv_deterministic(text)

    prompt = f"""You are an elite ATS CV Intelligence analyzer and resume parser.
Analyze this resume text and return STRICT VALID JSON ONLY (no markdown backticks, no commentary):
{{
  "name": "Full Candidate Name",
  "default_title": "Accurate Target Job Title (e.g. Graphic Designer, Chartered Accountant, Full Stack Developer, QA Engineer, Marketing Specialist)",
  "discipline": "one of: design, development, marketing, accounting, qa, hr, sales, data, other",
  "contact": {{
    "email": "Email address",
    "phone": "Phone number with country code",
    "location": "City or Country",
    "linkedin": "LinkedIn profile link or username",
    "github": "Portfolio / Behance / GitHub link"
  }},
  "location": "City or Country",
  "default_summary": "Crisp 2-3 sentence executive profile summary emphasizing domain impact and quantifiable achievements",
  "ats_score": 75,
  "skills": {{
    "Core Competencies": ["skill1", "skill2"],
    "Tools & Platforms": ["tool1", "tool2"]
  }},
  "experience": [
    {{
      "company": "Company Name",
      "role": "Role Title",
      "years": "Duration (e.g. 2023 - Present)",
      "bullets": ["Quantified accomplishment bullet 1", "bullet 2"]
    }}
  ],
  "education": "Degree or Qualification",
  "identified_gaps": ["Gap 1", "Gap 2"],
  "tailored_quantified_bullets": ["Google XYZ impact bullet with % and numbers", "bullet 2"]
}}

RESUME TEXT:
{text[:4500]}
"""
    try:
        reply = call_gemini(prompt, timeout=14)
        if reply:
            clean = reply.replace("```json", "").replace("```", "").strip()
            data = json.loads(clean)
            if data.get("name") and data.get("default_title"):
                if "contact" not in data:
                    data["contact"] = {}
                if "skills" not in data:
                    data["skills"] = {}
                if "discipline" not in data or not data["discipline"]:
                    dlist = get_job_discipline(data.get("default_title", ""))
                    data["discipline"] = dlist[0] if dlist else "other"
                elif isinstance(data["discipline"], list):
                    data["discipline"] = data["discipline"][0] if data["discipline"] else "other"
                data["discipline"] = str(data["discipline"]).lower().strip()
                return data
    except Exception as e:
        print("[Gemini CV Parsing Fallback]", e)

    return parse_cv_deterministic(text)



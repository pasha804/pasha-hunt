                    f.write(raw_bytes)

            prof_file = resolve_file("profile.json", for_write=True)
            with open(prof_file, "w", encoding="utf-8") as f:
                json.dump(parsed_info, f, indent=2, ensure_ascii=False)

            if os.path.exists("E:\\Job Hunt\\profile.json") and user_data_dir != "E:\\Job Hunt":
                try:
                    with open("E:\\Job Hunt\\profile.json", "w", encoding="utf-8") as f:
                        json.dump(parsed_info, f, indent=2, ensure_ascii=False)
                except Exception:
                    pass

            # Update keywords in config.json to match candidate's actual domain
            keywords = [cand_title]

    if loc_m:
        contact["location"] = loc_m.group(0)

    # 5. CANDIDATE NAME (Handles 2-line split names like 'Muhammad\nHasnain')
    name = ""
    non_name_tokens = {"curriculum", "vitae", "resume", "cv", "page", "email", "phone", "profile", "summary", "contact", "info", "linkedin", "behance", "github", "skills", "experience", "education"}
    if len(lines) >= 2:
        w1 = lines[0].strip().split()
        w2 = lines[1].strip().split()
        if len(w1) == 1 and len(w2) == 1:
            if w1[0].lower() not in non_name_tokens and w2[0].lower() not in non_name_tokens:
                name = f"{w1[0]} {w2[0]}".title()
    if not name:
        for l in lines[:5]:
            clean_l = re.sub(r"\b(ACA|FCA|ACCA|CA|PHD|PH\.D|MSC|BSC|MBA|PMP|CPA)\b", "", l, flags=re.I)
            clean_l = re.sub(r"[,|•/\\].*", "", clean_l).strip()
            words = clean_l.split()
            if 2 <= len(words) <= 4 and not any(k in clean_l.lower() for k in non_name_tokens):
                name = clean_l.title()
                break
    if not name and lines:
        name = lines[0].strip().title()

    # Normalize common PDF space artifacts
    normalized_text = text
    spaced_replacements = [
        (r'Figm\s*a', 'Figma'),
        (r'Photosho\s*p', 'Photoshop'),
        (r'Illustrato\s*r', 'Illustrator'),
        (r'Canv\s*a', 'Canva'),
        (r'Brandin\s*g', 'Branding'),
        (r'T\s*ypography', 'Typography'),
        (r'After\s*Eff\s*ects', 'After Effects')
    ]
    for pattern, repl in spaced_replacements:
        normalized_text = re.sub(pattern, repl, normalized_text, flags=re.I)

    text_lower = normalized_text.lower()

    # 6. DISCIPLINE & ROLE RULES
    role_rules = [
        ("design", "Lead UI/UX & Graphic Designer", [

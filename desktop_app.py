def resolve_video_path():
    candidates = []
    if getattr(sys, 'frozen', False):
        exe_dir = os.path.dirname(sys.executable)
        candidates.append(os.path.join(exe_dir, "intro.mp4"))
        if hasattr(sys, '_MEIPASS'):
            candidates.append(os.path.join(sys._MEIPASS, "intro.mp4"))
    candidates.append(os.path.join(HERE, "intro.mp4"))
    candidates.append(os.path.join(os.path.dirname(HERE), "intro.mp4"))
    local_app_data = os.environ.get("LOCALAPPDATA", "")
    if local_app_data:
        candidates.append(os.path.join(local_app_data, "Programs", "Pasha Hunt", "intro.mp4"))
        candidates.append(os.path.join(local_app_data, "Programs", "Job Hunter", "intro.mp4"))
    for c in candidates:
        if os.path.exists(c):
            return c
    return None


def wait_for_server(port=58241, timeout=4.0):
    import socket
    start = time.time()
    while time.time() - start < timeout:
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.2):
                return True
        except Exception:
            time.sleep(0.05)
    return False


class NativeVideoSplash(QtWidgets.QWidget):
    finished = QtCore.Signal()

    def __init__(self, video_path):
        super().__init__()
        self.setWindowFlags(QtCore.Qt.FramelessWindowHint | QtCore.Qt.WindowStaysOnTopHint | QtCore.Qt.Tool)
        self.setAttribute(QtCore.Qt.WA_TranslucentBackground, False)
        self.setStyleSheet("background-color: #070A0E;")
        
        self.video_path = video_path
        self.cap = cv2.VideoCapture(self.video_path)
        if not self.cap or not self.cap.isOpened():
            print(f"[Splash] Notice: OpenCV could not decode {self.video_path}. Proceeding directly.")
            QtCore.QTimer.singleShot(0, self.close_and_finish)
            return
        
        # 16:9 cinematic aspect ratio centered
        self.video_w = 960
        self.video_h = 540
        self.resize(self.video_w, self.video_h)
        
        # Center on primary monitor
        screen = QtGui.QGuiApplication.primaryScreen().geometry()
        x = (screen.width() - self.video_w) // 2
        y = (screen.height() - self.video_h) // 2
        self.move(x, y)
        
        # Video render canvas
        self.label = QtWidgets.QLabel(self)
        self.label.setGeometry(0, 0, self.video_w, self.video_h)
        self.label.setScaledContents(True)

        # Skip Intro Button
        self.skip_btn = QtWidgets.QPushButton("Skip Intro [Esc] ⏭", self)
        self.skip_btn.setGeometry(self.video_w - 180, self.video_h - 55, 160, 36)
        self.skip_btn.setCursor(QtGui.Qt.PointingHandCursor)
        self.skip_btn.setStyleSheet("""
            QPushButton {
                background-color: rgba(14, 19, 24, 0.88);
                border: 1px solid #FF6B00;
                color: #FFFFFF;
                font-family: -apple-system, Segoe UI, sans-serif;
                font-size: 12px;
                font-weight: 700;
                border-radius: 18px;
            }
            QPushButton:hover {
                background-color: #FF6B00;
                color: #000000;
            }
        """)
        self.skip_btn.clicked.connect(self.close_and_finish)

        # 24 FPS timer (~41ms)
        self.timer = QtCore.QTimer(self)
        self.timer.timeout.connect(self.next_frame)
        self.timer.start(41)

    def next_frame(self):
        if not self.cap or not self.cap.isOpened():
            self.close_and_finish()
            return
        ret, frame = self.cap.read()
        if not ret:
            self.close_and_finish()
            return
        
        # Convert BGR to RGB
        rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        h, w, ch = rgb.shape
        bytes_per_line = ch * w
        q_img = QtGui.QImage(rgb.data, w, h, bytes_per_line, QtGui.QImage.Format_RGB888)
        self.label.setPixmap(QtGui.QPixmap.fromImage(q_img))

    def keyPressEvent(self, event):
        if event.key() in (QtCore.Qt.Key_Escape, QtCore.Qt.Key_Space, QtCore.Qt.Key_Return):
            self.close_and_finish()

    def mousePressEvent(self, event):
        self.close_and_finish()

    def close_and_finish(self):
        if hasattr(self, "timer") and self.timer.isActive():
            self.timer.stop()
        if hasattr(self, "cap") and self.cap:
            self.cap.release()
            self.cap = None
        self.finished.emit()


class CustomWebEnginePage(QtWebEngineCore.QWebEnginePage):
    """Intercepts external job portal and website links and opens them in default OS browser."""
    def acceptNavigationRequest(self, url, nav_type, is_main_frame):
        url_str = url.toString()
        if nav_type == QtWebEngineCore.QWebEnginePage.NavigationType.NavigationTypeLinkClicked:
            if not url_str.startswith("http://127.0.0.1") and not url_str.startswith("http://localhost"):
                webbrowser.open(url_str)
                return False
        return super().acceptNavigationRequest(url, nav_type, is_main_frame)

    def createWindow(self, type_):
        class ExternalRedirectPage(QtWebEngineCore.QWebEnginePage):
            def acceptNavigationRequest(self, url, nav_type, is_main_frame):
                url_str = url.toString()
                if not url_str.startswith("http://127.0.0.1") and not url_str.startswith("http://localhost") and url_str != "about:blank":
                    webbrowser.open(url_str)
                return False
        return ExternalRedirectPage(self.parent())


class WorkstationWindow(QtWidgets.QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Pasha Hunt 2.0 — APINEX Edition")
        self.resize(1360, 880)
        self.setMinimumSize(1100, 720)

        # Clean background without WA_NativeWindow (prevents WM_ERASEBKGND flicker)
        self.setStyleSheet("background-color: #070A0E;")

        # Set Application Icon
        icon_path = os.path.join(HERE, "installer", "icon.ico")
        if not os.path.exists(icon_path):
            icon_path = os.path.join(HERE, "icon.ico")
        if os.path.exists(icon_path):
            self.setWindowIcon(QtGui.QIcon(icon_path))

        # Port for IPC Server
        self.port = 58241

        # Connect replay callback
        desktop_server.set_replay_intro_callback(self.replay_intro)

        # WebEngine View with dark background (NO QSS on QWebEngineView to prevent repaint loops)
        self.browser = QtWebEngineWidgets.QWebEngineView(self)
        self.custom_page = CustomWebEnginePage(self.browser)
        self.browser.setPage(self.custom_page)
        self.browser.page().setBackgroundColor(QtGui.QColor("#070A0E"))
        self.setCentralWidget(self.browser)

        # Initial URL load with single-attempt guard
        self._page_ready = False
        self._reload_count = 0
        self.browser.loadFinished.connect(self._on_load_finished)

        # Keyboard shortcuts
        self.refresh_shortcut = QtGui.QShortcut(QtGui.QKeySequence("F5"), self)
        self.refresh_shortcut.activated.connect(self.browser.reload)
        self.ctrl_r_shortcut = QtGui.QShortcut(QtGui.QKeySequence("Ctrl+R"), self)
        self.ctrl_r_shortcut.activated.connect(self.browser.reload)

        # Load IPC Server UI URL immediately
        self.browser.setUrl(QtCore.QUrl(f"http://127.0.0.1:{self.port}/"))

        # Background Scraper Thread state
        self.is_scanning = False

    def _on_load_finished(self, success):
        if success:
            self._page_ready = True
            self._reload_count = 0
        else:
            if not self._page_ready and self._reload_count < 1:
                self._reload_count += 1
                print(f"[Workstation] WebEngine load failed (attempt {self._reload_count}). Retrying...")
                QtCore.QTimer.singleShot(600, self.browser.reload)
            else:
                print("[Workstation] Load failed — not retrying to avoid flicker loop.")

    def replay_intro(self):
        """Replays cinematic intro splash natively upon user request."""
        video_path = resolve_video_path()
        if video_path and os.path.exists(video_path):
            self.splash = NativeVideoSplash(video_path)
            self.splash.finished.connect(self.splash.close)
            self.splash.show()

    def scan_jobs_async(self):
        """Asynchronously runs the 18 scraper feeds without blocking the GUI."""
        if self.is_scanning:
            return
        self.is_scanning = True
        threading.Thread(target=self._run_scrapers, daemon=True).start()

    def _run_scrapers(self):
        try:
            bot.src_all()
        except Exception as e:
            print("Scraper error:", e)
        finally:
            self.is_scanning = False



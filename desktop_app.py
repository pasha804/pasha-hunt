    palette.setColor(QtGui.QPalette.Highlight, QtGui.QColor("#FF6B00"))
    palette.setColor(QtGui.QPalette.HighlightedText, QtGui.QColor("#000000"))
    app.setPalette(palette)

    # Start Local IPC Server on 127.0.0.1:58241
    port = 58241
    server_thread = threading.Thread(
        target=desktop_server.start_server,
        args=(port,),
        daemon=True
    )
    server_thread.start()

    # Pre-verify server socket is actively listening before navigating UI
    wait_for_server(port, timeout=3.0)

    # Locate intro.mp4 reliably across paths
    video_path = resolve_video_path()

    def launch_main_workstation():
        global workstation_instance
        workstation_instance = WorkstationWindow()
        workstation_instance.show()
        workstation_instance.raise_()
        workstation_instance.activateWindow()

    # If video exists, play Native Video Splash FIRST, then launch Workstation separately
    if video_path and os.path.exists(video_path):
        splash = NativeVideoSplash(video_path)

        def on_splash_done():
            # Close splash first
            splash.close()
            # Launch workstation cleanly — 100% separated screens, zero overlap
            QtCore.QTimer.singleShot(100, launch_main_workstation)

        splash.finished.connect(on_splash_done)
        splash.show()
    else:
        launch_main_workstation()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
